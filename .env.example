# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Senha do admin de dev (mesmo valor de DEV_ADMIN_PASSWORD da API) — e2e Playwright.
DEV_ADMIN_PASSWORD=

# URL da API NestJS (nexus-api)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Domínio do CloudFront/S3 de imagens (Fase 7) — adiciona ao img-src do CSP
# (src/proxy.ts, spec.md §14). Vazio até a infra existir.
NEXT_PUBLIC_MEDIA_DOMAIN=
